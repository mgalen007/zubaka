---
import AccordionItem from "./AccordionItem.astro";

const content = [
{
  index: 1,
  title: "Find the plot",
  description: "Locate the parcel on the interactive map, or search directly by its Unique Parcel Identifier (UPI) — the same identifier used in official Kigali Masterplan records."
},
{
  index: 2,
  title: "See the real zoning",
  description: "Zubaka looks up the plot's actual boundary on the official map and matches it against the Kigali Masterplan's zoning categories — residential, commercial, mixed-use, or restricted/wetland — not whatever a broker tells you."
},
{
  index: 3,
  title: "Know what's allowed before you pay",
  description: "Get a plain-language report of what construction is permitted and what's restricted on that exact plot, plus an AI-generated explanation, so you can verify a broker's claims before any money changes hands."
}
];
---

{
  content.map((item) => {
    return (
      <AccordionItem
        index={item.index}
        title={item.title}
        description={item.description}
      />
    );
  })
}
