---
import { Image } from "astro:assets";
import Logo from "../../assets/logo-alt.svg";

const links = [
  { name: "Land Map", href: "/map" },
  { name: "UPI Search", href: "/search" },
  { name: "Zoning Rules", href: "/services" },
  { name: "AI Assistant", href: "/ai" },
  { name: "About Us", href: "/about" },
];
---

<section class="sm:px-5">
  <div class="w-full max-w-[1240px] mx-auto">
    <div
      class="px-[15px] bg-dark text-gray py-[55px] lg:px-[60px] sm:rounded-t-[45px]"
    >
      <div>
        <div
          class="flex flex-col lg:flex-row gap-7 items-center justify-between"
        >
          <picture>
            <a href="/">
              <Image src={Logo} alt="Zubaka logo" />
            </a>
          </picture>
          <ul class="flex flex-col sm:flex-row gap-5">
            {
              links.map((link) => {
                return (
                  <li class="text-center">
                    <a class="underline" href={link.href}>
                      {link.name}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="flex flex-col lg:flex-row mt-[66px] mb-[51px]">
          <div
            class="flex text-center lg:text-start flex-col w-full"
          >
            <h3 class="mb-5 text-center md:text-left text-2xl text-green">About Zubaka</h3>
            <p class="max-w-2xl">
              Zubaka helps prospective land buyers in Kigali verify a plot's real Masterplan zoning
              before dealing with informal brokers. This build runs on 17 mock parcels for demo purposes.
            </p>
          </div>
        </div>
      </div>

      <div class="h-[1px] bg-gray mb-5"></div>
      <div
        class="flex flex-col lg:flex-row h-20 justify-center mt-4 text-center md:justify-between md:mt-0"
      >
        <span>Zubaka — Kigali Land Use Masterplan &amp; Zoning Protection Platform</span>
      </div>
    </div>
  </div>
</section>
