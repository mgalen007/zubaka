---
import SectionTitle from "../ui/SectionTitle.astro";
import ServiceCard from "../ui/ServiceCard.astro";
import Section from "./Section.astro";

import c1 from "../../assets/pics/card-pic1.png";
import c2 from "../../assets/pics/card-pic2.png";
import c3 from "../../assets/pics/card-pic3.png";

const cards = [
  {
    index: 1,
    titleTop: "Interactive",
    titleBottom: "Land Map",
    img: c1,
    alt: "Kigali land map",
    link: "/map",
  },
  {
    index: 2,
    titleTop: "UPI",
    titleBottom: "Search",
    img: c2,
    alt: "UPI search",
    link: "/search",
  },
  {
    index: 3,
    titleTop: "Zoning",
    titleBottom: "Rules",
    img: c3,
    alt: "Kigali zoning rules",
    link: "/services",
  },
];

const description =
  "Everything you need to verify a plot's real zoning status before you deal with any land broker.";
---

<Section id="services">
  <div class="py-16 lg:py-24">
    <SectionTitle sectionTitle="Verify Before You Buy" description={description} />
    <div class="grid lg:grid-cols-2 lg:grid-rows-2 gap-10">
      {
        cards.map((card) => (
          <ServiceCard
            index={card.index}
            titleTop={card.titleTop}
            titleBottom={card.titleBottom}
            img={card.img}
            alt={card.alt}
            link={card.link}
          />
        ))
      }
    </div>
  </div>
</Section>
