---
import SectionTitle from "../components/ui/SectionTitle.astro";
import Section from "../components/sections/Section.astro";
import MainLayout from "../layouts/MainLayout.astro";
---


<MainLayout
  title="Zubaka AI Protection Assistant"
  description="Ask plain-language questions in Kinyarwanda or English about Kigali land masterplan rules, wetland demolition risks, and how to avoid informal broker scams."
>
  <Section>
    <div class="py-6">
      <SectionTitle
        sectionTitle="AI Land Protection Assistant"
        description="Grounded in Rwanda Land Authority laws and Kigali Masterplan rules to protect prospective buyers from illegal plot transactions."
      />

      <div class="rounded-[45px] bg-[#191a23] text-white p-8 sm:p-12 border-2 border-black shadow-[0px_5px_0px_#b9ff66] font-grotesk max-w-4xl mx-auto flex flex-col space-y-6">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-green flex items-center justify-center text-black font-bold text-xl">
              AI
            </div>
            <div>
              <h3 class="text-2xl font-medium text-white">Zubaka Land Protection AI</h3>
              <p class="text-xs text-green">Grounded in Kigali Masterplan 2050 Data</p>
            </div>
          </div>
          <span class="greenhead text-xs font-medium hidden sm:inline">
            Active Assistant
          </span>
        </div>

        <!-- Chat Stream -->
        <div id="ai-chat-stream" class="flex-1 min-h-[340px] max-h-[480px] overflow-y-auto space-y-4 pr-2">
          
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-xl bg-green flex items-center justify-center text-black font-bold text-xs shrink-0">
              AI
            </div>
            <div class="bg-zinc-800 text-zinc-100 p-4 rounded-2xl rounded-tl-none border border-zinc-700 text-sm leading-relaxed max-w-[85%]">
              Muraho! Ndi Zubaka AI Protection Assistant. Nshobora kugufasha ku nzu n'ubutaka mu Mujyi wa Kigali:
              <ul class="mt-2 space-y-1 text-xs text-zinc-300">
                <li>• Nshobora kubaka inzu yo guturamo mu igishanga?</li>
                <li>• Ni gute nzirinda abamotsi (informal brokers)?</li>
                <li>• Niki kiba nubatse bidafite urushya rw'ubwubatsi?</li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Quick Prompt Chips -->
        <div class="pt-2 border-t border-zinc-800">
          <span class="block text-xs font-medium text-zinc-400 mb-2">Ibikunze kubazwa (Popular Questions):</span>
          <div class="flex flex-wrap gap-2">
            <button class="ai-chip px-3.5 py-1.5 bg-zinc-800 hover:bg-green text-zinc-200 hover:text-black text-xs rounded-xl border border-zinc-700 transition-all duration-200 transform hover:scale-105">
              Nshobora kubaka mu igishanga?
            </button>
            <button class="ai-chip px-3.5 py-1.5 bg-zinc-800 hover:bg-green text-zinc-200 hover:text-black text-xs rounded-xl border border-zinc-700 transition-all duration-200 transform hover:scale-105">
              Ni gute nzirinda abamotsi?
            </button>
            <button class="ai-chip px-3.5 py-1.5 bg-zinc-800 hover:bg-green text-zinc-200 hover:text-black text-xs rounded-xl border border-zinc-700 transition-all duration-200 transform hover:scale-105">
              Amabwiriza ya zone R1 ni ayahe?
            </button>
          </div>
        </div>

        <!-- Input Form -->
        <form id="ai-page-form" class="flex gap-3 pt-2">
          <input
            type="text"
            id="ai-page-input"
            placeholder="Andika ikibazo cyanjye (Ask a question in Kinyarwanda or English)..."
            class="flex-1 bg-zinc-800 text-white placeholder-zinc-400 rounded-2xl px-5 py-4 border border-zinc-700 text-base focus:outline-none focus:ring-2 focus:ring-green"
          />
          <button
            type="submit"
            class="px-8 py-4 bg-green hover:bg-white text-black font-medium text-lg rounded-2xl border border-black shadow-[0px_3px_0px_#ffffff] transition-all duration-200 transform hover:scale-105 shrink-0"
          >
            Send Question
          </button>
        </form>

      </div>
    </div>
  </Section>

  <script is:inline>
    const chatStream = document.getElementById('ai-chat-stream');
    const pageForm = document.getElementById('ai-page-form');
    const pageInput = document.getElementById('ai-page-input');

    function appendUserMsg(text) {
      if (!chatStream) return;
      const div = document.createElement('div');
      div.className = 'flex items-start justify-end gap-3';
      div.innerHTML = `
        <div class="bg-green text-black font-medium p-4 rounded-2xl rounded-tr-none text-sm leading-relaxed max-w-[85%] shadow-md">
          ${escapeHtml(text)}
        </div>
        <div class="w-8 h-8 rounded-xl bg-white text-black font-bold text-xs flex items-center justify-center shrink-0">
          YOU
        </div>
      `;
      chatStream.appendChild(div);
      chatStream.scrollTop = chatStream.scrollHeight;
    }

    function appendAiMsg(text) {
      if (!chatStream) return;
      const div = document.createElement('div');
      div.className = 'flex items-start gap-3';
      div.innerHTML = `
        <div class="w-8 h-8 rounded-xl bg-green flex items-center justify-center text-black font-bold text-xs shrink-0">
          AI
        </div>
        <div class="bg-zinc-800 text-zinc-100 p-4 rounded-2xl rounded-tl-none border border-zinc-700 text-sm leading-relaxed max-w-[85%] shadow-md">
          ${escapeHtml(text)}
        </div>
      `;
      chatStream.appendChild(div);
      chatStream.scrollTop = chatStream.scrollHeight;
    }

    function respondToQuery(query) {
      const q = query.toLowerCase();
      let reply = "Ikibazo cyanyu cyakiriwe. Buri gihe saba icyangombwa cy'ubutaka icyo ari cyo cyose muri RLA kabone n'ubwo abamotsi baba babikwemereye.";

      if (q.includes('igishanga') || q.includes('wetland')) {
        reply = "DEMOLITION HAZARD: Kubaka mu igishanga cyangwa inkengero z'amazi mu Mujyi wa Kigali birabujijwe rwose. Inzu zose zubatse mu igishanga zihita zisenywa n'Umujyi wa Kigali bila arirwo rwose!";
      } else if (q.includes('abamotsi') || q.includes('broker')) {
        reply = "KWIRINDA ABAMOTSI: Abamotsi bakunze kugurisha ubutaka butari muri zone yo guturamo. Buri gihe jya kuri shaka y'ubutaka (search bar) uhereye ku numero ya UPI cyangwa uganire n'ibiro by'Umujyi wa Kigali!";
      } else if (q.includes('r1')) {
        reply = "Zone ya R1 (Single Family Residential) iremewe kubakamo inzu yo guturamo y'umuryango umwe gusa idasumba etaje 2.";
      }

      setTimeout(() => {
        appendAiMsg(reply);
      }, 400);
    }

    function escapeHtml(unsafe) {
      return unsafe
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (pageForm && pageInput) {
        pageForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const val = pageInput.value.trim();
          if (val) {
            appendUserMsg(val);
            respondToQuery(val);
            pageInput.value = '';
          }
        });
      }

      document.querySelectorAll('.ai-chip').forEach(chip => {
        chip.addEventListener('click', (e) => {
          const txt = e.currentTarget.textContent.trim();
          if (txt) {
            appendUserMsg(txt);
            respondToQuery(txt);
          }
        });
      });
    });
  </script>
</MainLayout>
