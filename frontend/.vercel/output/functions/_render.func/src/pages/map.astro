---
import Card from "../components/ui/Card.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import Section from "../components/sections/Section.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Icon from "../components/ui/Icon.astro";
---

<MainLayout
  title="Interactive Kigali Land Map — Zubaka"
  description="Browse real plots of land across Kigali on a map, and check each one's official zoning before you buy."
>
  <Section>
    <div class="py-6">
      <SectionTitle
        sectionTitle="Interactive Land Map"
        description="Browse plots on the map, see their official Kigali Masterplan zoning, and check what's allowed to be built there before you pay anyone."
      />

      <Card isUnderline={true}>
        <div class="p-6 sm:p-10 bg-white rounded-[45px] flex flex-col space-y-8 font-grotesk">

          <!-- Map Canvas & Inspector Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <!-- Map Column (7 cols) -->
            <div class="lg:col-span-7 flex flex-col space-y-3">
              <div class="relative w-full rounded-[30px] border-2 border-black shadow-[0px_5px_0px_#191a23] overflow-hidden bg-zinc-100">
                <div id="leaflet-map" class="w-full h-[540px] z-10"></div>

                <!-- Tile loading indicator -->
                <div id="map-tile-loading" class="hidden absolute top-4 left-4 z-20 px-3 py-1.5 bg-white text-black text-xs rounded-xl border border-black shadow-[0px_2px_0px_#191a23]">
                  Loading map...
                </div>

                <!-- Refresh area button -->
                <button
                  id="btn-bbox-refresh"
                  class="absolute bottom-4 left-4 z-20 px-4 py-2 bg-white hover:bg-black text-black hover:text-white border-2 border-black rounded-xl text-xs font-medium shadow-[0px_2px_0px_#191a23] transition-all duration-200 transform hover:scale-105"
                >
                  Refresh This Area
                </button>

                <!-- Status Badge -->
                <div class="absolute top-4 right-4 z-20 px-3.5 py-1.5 bg-black text-white text-xs rounded-xl border border-black">
                  <span id="map-counter">Loading plots...</span>
                </div>
              </div>

              <!-- Fetch error banner -->
              <div id="map-error-banner" class="hidden p-3 rounded-xl border-2 border-black bg-rose-100 text-xs text-black flex items-center justify-between gap-3">
                <span>Couldn't load plots right now — check your connection and try again.</span>
                <button id="btn-map-error-retry" class="shrink-0 px-3 py-1.5 bg-black text-white rounded-lg text-xs font-medium hover:bg-rose-600 transition-all duration-200 transform hover:scale-105">
                  Retry
                </button>
              </div>

              <p class="text-xs text-zinc-500 italic">
                * Click anywhere on the map to check that spot, or click a plot outline for its full report.
              </p>
            </div>

            <!-- Inspector Drawer Column (5 cols) -->
            <div class="lg:col-span-5 w-full">
              <div class="rounded-[35px] border-2 border-black shadow-[0px_5px_0px_#191a23] bg-[#f3f3f3] p-6 sm:p-8 flex flex-col space-y-5">

                <!-- Empty State -->
                <div id="inspector-empty" class="py-16 text-center flex flex-col items-center space-y-3">
                  <div class="w-16 h-16 rounded-2xl bg-green border-2 border-black flex items-center justify-center text-black shadow-[0px_3px_0px_#191a23]">
                    <Icon name="map-pin" class="w-8 h-8" />
                  </div>
                  <h3 class="text-xl font-medium text-black">Select a Plot on the Map</h3>
                  <p class="text-sm text-zinc-600 max-w-xs">
                    Click any plot outline to see its zoning, allowed uses, and a plain-language safety report.
                  </p>

                </div>

                <!-- Loading State -->
                <div id="inspector-loading" class="hidden py-20 text-center">
                  <div class="w-10 h-10 border-4 border-black border-t-green rounded-full animate-spin mx-auto mb-3"></div>
                  <p class="text-sm font-medium text-black">Checking this plot...</p>
                </div>

                <!-- Error State -->
                <div id="inspector-error" class="hidden py-16 text-center flex flex-col items-center space-y-3">
                  <div class="w-16 h-16 rounded-2xl bg-rose-100 border-2 border-black flex items-center justify-center text-black shadow-[0px_3px_0px_#191a23]">
                    <Icon name="warning-circle" class="w-8 h-8" />
                  </div>
                  <h3 class="text-xl font-medium text-black">No Report Available</h3>
                  <p id="inspector-error-text" class="text-sm text-zinc-600 max-w-xs">
                    We couldn't find a report for that spot. Try clicking directly on a plot outline.
                  </p>
                </div>

                <!-- Active Content -->
                <div id="inspector-content" class="hidden flex flex-col space-y-5">

                  <div class="flex items-center justify-between">
                    <span id="detail-badge" class="greenhead text-sm font-medium">
                      RESIDENTIAL
                    </span>
                    <span id="detail-area" class="bg-white border border-black px-3 py-1 rounded-xl text-xs font-mono text-black">
                      --- m²
                    </span>
                  </div>

                  <div>
                    <h3 id="detail-upi" class="text-3xl font-medium text-black leading-tight">
                      UPI-00000
                    </h3>
                    <p class="text-xs text-zinc-500 mt-1">Kigali City Land Use Masterplan</p>
                  </div>

                  <!-- Risk Notice -->
                  <div id="detail-risk-card" class="p-4 rounded-2xl border-2 border-black bg-white shadow-[0px_3px_0px_#191a23]">
                    <h4 class="text-base font-medium text-black mb-1 flex items-center gap-1.5">
                      <Icon name="warning" id="detail-risk-icon-warning" class="w-4 h-4 hidden shrink-0" />
                      <Icon name="check-circle" id="detail-risk-icon-ok" class="w-4 h-4 shrink-0" />
                      <span id="detail-risk-title">Compliance Status</span>
                    </h4>
                    <p id="detail-risk-text" class="text-xs text-zinc-700 leading-relaxed">
                      Evaluation loaded...
                    </p>
                  </div>

                  <!-- Allowed Uses -->
                  <div class="bg-white p-4 rounded-2xl border border-black">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-black mb-2 flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                      Ibyemewe Kwubakwa (Allowed Uses)
                    </h4>
                    <ul id="detail-allowed-list" class="space-y-1 text-xs text-zinc-700">
                      <!-- Dynamic -->
                    </ul>
                  </div>

                  <!-- Restricted Uses -->
                  <div class="bg-white p-4 rounded-2xl border border-black">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-rose-600 mb-2 flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                      Ibibujijwe (Restricted Uses)
                    </h4>
                    <ul id="detail-restricted-list" class="space-y-1 text-xs text-zinc-700">
                      <!-- Dynamic -->
                    </ul>
                  </div>

                  <!-- AI Protection Advisory -->
                  <div class="bg-green p-4 rounded-2xl border-2 border-black shadow-[0px_3px_0px_#191a23]">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-black mb-1 flex items-center gap-1.5">
                      <Icon name="lightbulb" class="w-3.5 h-3.5" />
                      AI Land Protection Advisory
                    </h4>
                    <p id="detail-ai-explanation" class="text-xs text-black leading-relaxed font-normal">
                      Generating explanation...
                    </p>
                  </div>

                  <button
                    id="btn-print-report"
                    class="w-full py-4 bg-black hover:bg-green text-white hover:text-black rounded-2xl border-2 border-black text-base font-medium transition-all duration-200 transform hover:scale-105 shadow-[0px_3px_0px_#191a23]"
                  >
                    Print Safety Report
                  </button>

                </div>

              </div>
            </div>

          </div>

        </div>
      </Card>
    </div>
  </Section>

  <script>
    import L from "leaflet";
    import "leaflet/dist/leaflet.css";
    import { getParcels, getParcelAtPoint, getParcelReport } from "../lib/api";
    import { getZoningColor, isHazardZoning } from "../lib/zoning";
    import type { ParcelFeature, ParcelFeatureCollection, LandReport } from "../lib/api";

    let map: L.Map | null = null;
    let geoJsonLayer: L.GeoJSON | null = null;
    let selectedLayer: L.Layer | null = null;
    let parcelFeatures: ParcelFeature[] = [];
    let lastBbox: string | undefined;

    const mapCounter = document.getElementById('map-counter');
    const tileLoadingBadge = document.getElementById('map-tile-loading');
    const mapErrorBanner = document.getElementById('map-error-banner');
    const emptyState = document.getElementById('inspector-empty');
    const loadingState = document.getElementById('inspector-loading');
    const errorState = document.getElementById('inspector-error');
    const errorStateText = document.getElementById('inspector-error-text');
    const contentState = document.getElementById('inspector-content');

    const detailUpi = document.getElementById('detail-upi');
    const detailBadge = document.getElementById('detail-badge');
    const detailArea = document.getElementById('detail-area');
    const detailRiskCard = document.getElementById('detail-risk-card');
    const detailRiskTitle = document.getElementById('detail-risk-title');
    const detailRiskIconWarning = document.getElementById('detail-risk-icon-warning');
    const detailRiskIconOk = document.getElementById('detail-risk-icon-ok');
    const detailRiskText = document.getElementById('detail-risk-text');
    const detailAllowedList = document.getElementById('detail-allowed-list');
    const detailRestrictedList = document.getElementById('detail-restricted-list');
    const detailAiExplanation = document.getElementById('detail-ai-explanation');

    function initMap() {
      map = L.map('leaflet-map', { zoomControl: true }).setView([-1.9441, 30.0619], 13);

      const tiles = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19,
      }).addTo(map);

      tiles.on('loading', () => {
        if (tileLoadingBadge) tileLoadingBadge.classList.remove('hidden');
      });
      tiles.on('load', () => {
        if (tileLoadingBadge) tileLoadingBadge.classList.add('hidden');
      });

      fetchParcels();

      map.on('click', (e) => {
        handlePointLookup(e.latlng.lng, e.latlng.lat);
      });
    }

    async function fetchParcels(bbox?: string) {
      lastBbox = bbox;
      if (mapCounter) mapCounter.textContent = 'Loading plots...';
      if (mapErrorBanner) mapErrorBanner.classList.add('hidden');
      try {
        const data = await getParcels(bbox);
        parcelFeatures = data.features || [];
        if (mapCounter) {
          mapCounter.textContent = parcelFeatures.length === 1
            ? '1 plot in this area'
            : `${parcelFeatures.length} plots in this area`;
        }

        renderGeoJson(data);
      } catch (err) {
        console.error('Error fetching parcels:', err);
        if (mapCounter) mapCounter.textContent = 'Couldn\'t load plots';
        if (mapErrorBanner) mapErrorBanner.classList.remove('hidden');
      }
    }

    function renderGeoJson(data: ParcelFeatureCollection) {
      if (!map) return;
      if (geoJsonLayer) map.removeLayer(geoJsonLayer);

      geoJsonLayer = L.geoJSON(data as GeoJSON.FeatureCollection, {
        style: (feature) => {
          const zoning = feature?.properties?.zoning || 'residential';
          const color = getZoningColor(zoning);
          const isHazard = isHazardZoning(zoning);
          return {
            color: '#191a23',
            weight: 2,
            fillColor: color,
            fillOpacity: isHazard ? 0.75 : 0.5,
          };
        },
        onEachFeature: (feature, layer) => {
          const upi = feature.properties.upi;
          const zoning = feature.properties.zoning;
          layer.bindTooltip(`<b>UPI: ${upi}</b><br/>Zone: ${zoning}`);

          layer.on('mouseover', () => {
            const styledLayer = layer as L.Path;
            if (layer !== selectedLayer && styledLayer.setStyle) {
              styledLayer.setStyle({ weight: 3, fillOpacity: 0.75 });
              styledLayer.bringToFront();
            }
          });

          layer.on('mouseout', () => {
            if (layer !== selectedLayer && geoJsonLayer) {
              geoJsonLayer.resetStyle(layer);
            }
          });

          layer.on('click', (e) => {
            L.DomEvent.stopPropagation(e);
            highlightLayer(layer);
            loadReport(feature.properties.id);
          });
        },
      }).addTo(map);

      if (parcelFeatures.length > 0 && geoJsonLayer) {
        map.fitBounds(geoJsonLayer.getBounds(), { padding: [30, 30] });
      }
    }

    function highlightLayer(layer: L.Layer) {
      if (selectedLayer && geoJsonLayer) {
        geoJsonLayer.resetStyle(selectedLayer);
      }
      selectedLayer = layer;
      const styledLayer = layer as L.Path;
      if (styledLayer.setStyle) {
        styledLayer.setStyle({
          weight: 4,
          color: '#000000',
          fillOpacity: 0.85,
        });
      }
    }

    async function loadReport(parcelId: string) {
      showState('loading');
      try {
        const report = await getParcelReport(parcelId);
        displayReport(report);
      } catch (err) {
        console.error('Report error:', err);
        if (errorStateText) errorStateText.textContent = 'We couldn\'t load a report for that plot. Please try again.';
        showState('error');
      }
    }

    async function handlePointLookup(lng: number, lat: number) {
      showState('loading');
      try {
        const feature = await getParcelAtPoint(lng, lat);
        if (feature && feature.properties) {
          const id = feature.properties.id;

          if (geoJsonLayer) {
            geoJsonLayer.eachLayer((layer) => {
              const layerFeature = (layer as L.Layer & { feature?: ParcelFeature }).feature;
              if (layerFeature && layerFeature.properties.id === id) {
                highlightLayer(layer);
              }
            });
          }
          loadReport(id);
        } else {
          if (errorStateText) errorStateText.textContent = 'No plot found at that spot. Try clicking directly on a plot outline.';
          showState('error');
        }
      } catch (err) {
        console.error('Point lookup error:', err);
        if (errorStateText) errorStateText.textContent = 'Something went wrong checking that spot. Please try again.';
        showState('error');
      }
    }

    function displayReport(report: LandReport) {
      if (detailUpi) detailUpi.textContent = report.upi || 'N/A';
      if (detailArea) detailArea.textContent = report.area_m2 ? `${Math.round(report.area_m2).toLocaleString()} m²` : 'N/A';

      const isHazard = isHazardZoning(report.zoning);

      if (detailBadge) {
        detailBadge.textContent = (report.zoning || 'RESIDENTIAL').toUpperCase();
        detailBadge.className = isHazard
          ? 'bg-rose-500 text-white rounded-[7px] px-[7px] text-sm font-medium'
          : 'greenhead text-sm font-medium';
      }

      if (detailRiskCard && detailRiskTitle && detailRiskText) {
        if (isHazard) {
          detailRiskCard.className = 'p-4 rounded-2xl border-2 border-black bg-rose-100 shadow-[0px_3px_0px_#191a23]';
          detailRiskTitle.textContent = 'DEMOLITION HAZARD WARNING';
          detailRiskText.textContent = 'This plot is in a restricted wetland or hazard buffer. Unpermitted construction is subject to immediate municipal demolition.';
          detailRiskIconWarning?.classList.remove('hidden');
          detailRiskIconOk?.classList.add('hidden');
        } else {
          detailRiskCard.className = 'p-4 rounded-2xl border-2 border-black bg-white shadow-[0px_3px_0px_#191a23]';
          detailRiskTitle.textContent = 'Approved Masterplan Zoning';
          detailRiskText.textContent = 'Permitted for residential or mixed construction in compliance with Kigali City guidelines.';
          detailRiskIconWarning?.classList.add('hidden');
          detailRiskIconOk?.classList.remove('hidden');
        }
      }

      if (detailAllowedList) {
        const allowed = report.allowed_uses || [];
        detailAllowedList.innerHTML = allowed.map((item) => `<li>• ${item}</li>`).join('') || '<li class="italic text-zinc-400">None specified</li>';
      }

      if (detailRestrictedList) {
        const restricted = report.restricted_uses || [];
        detailRestrictedList.innerHTML = restricted.map((item) => `<li>• ${item}</li>`).join('') || '<li class="italic text-zinc-400">None specified</li>';
      }

      if (detailAiExplanation) {
        detailAiExplanation.textContent = report.ai_explanation || 'No explanation generated.';
      }

      showState('content');
    }

    function showState(st: 'empty' | 'loading' | 'error' | 'content') {
      if (emptyState) emptyState.classList.toggle('hidden', st !== 'empty');
      if (loadingState) loadingState.classList.toggle('hidden', st !== 'loading');
      if (errorState) errorState.classList.toggle('hidden', st !== 'error');
      if (contentState) contentState.classList.toggle('hidden', st !== 'content');
    }

    document.addEventListener('DOMContentLoaded', () => {
      initMap();

      const refreshBtn = document.getElementById('btn-bbox-refresh');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => {
          if (!map) return;
          const bounds = map.getBounds();
          fetchParcels(`${bounds.getWest()},${bounds.getSouth()},${bounds.getEast()},${bounds.getNorth()}`);
        });
      }

      const retryBtn = document.getElementById('btn-map-error-retry');
      if (retryBtn) {
        retryBtn.addEventListener('click', () => {
          fetchParcels(lastBbox);
        });
      }

      const printBtn = document.getElementById('btn-print-report');
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          window.print();
        });
      }
    });
  </script>
</MainLayout>
